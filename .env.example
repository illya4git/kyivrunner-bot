# Telegram bot token from @BotFather
BOT_TOKEN=
# Comma-separated Telegram user ids that are always admins
ADMIN_IDS=
# 32-byte key, base64 (generate: openssl rand -base64 32). Encrypts the Kyiv Digital token at rest.
ENCRYPTION_KEY=
# SQLite file path
DB_PATH=./data/bot.sqlite
# The Kyiv Digital app's static X-Client-Auth header (64 hex chars), required for the real API.
# It is a constant in the app (see docs/README.md, "The request envelope"); not published here.
KYIV_CLIENT_AUTH=
# Kyiv Digital API base URL. Anything other than https://kyiv.digital requires DEV_MODE=true.
KYIV_BASE_URL=https://kyiv.digital
DEV_MODE=false
# Use Telegram's test servers (separate accounts and bots; see https://core.telegram.org/bots/features#testing-your-bot)
TELEGRAM_TEST_ENV=false
LOG_LEVEL=info
# Nightly backups (default: backups/ next to the database) and how many to keep
# BACKUP_DIR=
# BACKUP_KEEP=14
# Local healthcheck endpoint for Docker (0 disables)
# HEALTH_PORT=8080
